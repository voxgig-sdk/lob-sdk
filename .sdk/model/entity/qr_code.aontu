# Entity: qr_code

main: kit: entity: qr_code: {

  alias: field: {}

  fields: {
    date_created: {
      fo: "date-time"
      h: "Date Created"
      n: "date_created"
      r: false
      sh: "A timestamp in ISO 8601 format of the date the resource was created."
      t: "`$STRING`"
    }
    number_of_scans: {
      h: "Number Of Scans"
      n: "number_of_scans"
      r: false
      sh: "Number of times the QR Code associated with this mail piece was scanned."
      t: "`$NUMBER`"
    }
    resource_id: {
      h: "Resource Id"
      n: "resource_id"
      r: false
      sh: "Unique identifier for each mail piece."
      t: "`$STRING`"
    }
    scans: {
      h: "Scans"
      n: "scans"
      r: false
      sh: "Detailed scan information associated with each mail piece."
      t: "`$ARRAY`"
    }
  }

  name: "qr_code"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /qr_code_analytics"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                k: "query"
                n: "date_created"
                or: "date_created"
                r: false
                t: "`$OBJECT`"
              }
              {
                k: "query"
                n: "include"
                or: "include"
                r: false
                t: "`$ARRAY`"
              }
              {
                ex: 10
                k: "query"
                n: "limit"
                or: "limit"
                r: false
                t: "`$INTEGER`"
              }
              {
                ex: 0
                k: "query"
                n: "offset"
                or: "offset"
                r: false
                t: "`$INTEGER`"
              }
              {
                k: "query"
                n: "resource_id"
                or: "resource_ids"
                r: false
                t: "`$ARRAY`"
              }
              {
                k: "query"
                n: "scanned"
                or: "scanned"
                r: false
                t: "`$BOOLEAN`"
              }
            ]
          }
          m: "GET"
          o: "/qr_code_analytics"
          q: {
            exist: [
              "date_created"
              "include"
              "limit"
              "offset"
              "resource_id"
              "scanned"
            ]
          }
          s: [
            {
              lit: "qr_code_analytics"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
      ]
    }
  }



}
