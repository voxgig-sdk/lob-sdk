# Entity: us_autocompletion

main: kit: entity: us_autocompletion: {

  alias: field: {}

  fields: {
    address_prefix: {
      h: "Address Prefix"
      n: "address_prefix"
      r: true
      sh: "Only accepts numbers and street names in an alphanumeric format."
      t: "`$STRING`"
    }
    city: {
      h: "City"
      n: "city"
      r: false
      sh: "An optional city input used to filter suggestions."
      t: "`$STRING`"
    }
    geo_ip_sort: {
      h: "Geo Ip Sort"
      n: "geo_ip_sort"
      r: false
      sh: "If `true`, sort suggestions by proximity to the IP set in the `X-Forwarded-For` header."
      t: "`$BOOLEAN`"
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      sh: "Unique identifier prefixed with `us_auto_`."
      t: "`$STRING`"
    }
    object: {
      h: "Object"
      n: "object"
      r: false
      sh: "Value is resource type."
      t: "`$STRING`"
    }
    state: {
      h: "State"
      n: "state"
      r: false
      sh: "An optional state input used to filter suggestions."
      t: "`$STRING`"
    }
    suggestions: {
      h: "Suggestions"
      n: "suggestions"
      r: false
      sh: "An array of objects representing suggested addresses."
      t: "`$ARRAY`"
    }
    zip_code: {
      h: "Zip Code"
      n: "zip_code"
      r: false
      sh: "An optional ZIP Code input used to filter suggestions."
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "us_autocompletion"
  op: {
    create: {
      name: "create"
      points: [
        {
          co: {
            id: "POST /us_autocompletions"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                ex: "upper"
                k: "query"
                n: "case"
                or: "case"
                r: false
                t: "`$STRING`"
              }
              {
                ex: false
                k: "query"
                n: "valid_address"
                or: "valid_address"
                r: false
                t: "`$BOOLEAN`"
              }
            ]
          }
          m: "POST"
          o: "/us_autocompletions"
          q: {
            exist: [
              "case"
              "valid_address"
            ]
          }
          s: [
            {
              lit: "us_autocompletions"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
