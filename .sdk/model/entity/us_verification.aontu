      t: "`$STRING`"
    }
    lob_confidence_score: {
      h: "Lob Confidence Score"
      n: "lob_confidence_score"
      r: true
      sh: "Lob Confidence Score is a nested object that provides a numerical value between 0-100 of the likelihood that an address is deliverable based on Lob’s mail delivery data to over half of US households."
      t: "`$OBJECT`"
    }
    object: {
      h: "Object"
      n: "object"
      r: false
      sh: "Value is resource type."
      t: "`$STRING`"
    }
    primary_line: {
      h: "Primary Line"
      n: "primary_line"
      r: false
      sh: "The primary delivery line (usually the street address) of the address."
