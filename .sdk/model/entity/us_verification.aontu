    }
    secondary_line: {
      h: "Secondary Line"
      n: "secondary_line"
      r: false
      sh: "The secondary delivery line of the address."
      t: "`$STRING`"
    }
    urbanization: {
      h: "Urbanization"
      n: "urbanization"
      r: false
      sh: "Only present for addresses in Puerto Rico."
      t: "`$STRING`"
    }
    valid_address: {
      h: "Valid Address"
      n: "valid_address"
      r: false
      sh: "This field indicates whether an address was found in a more comprehensive address dataset that includes sources from the USPS, open source mapping data, and our proprietary mail delivery data."
      t: "`$BOOLEAN`"
    }
  }

