    total_count: {
      h: "Total Count"
      n: "total_count"
      r: false
      sh: "Indicates the total number of records."
      t: "`$INTEGER`"
    }
    uploads: {
      h: "Uploads"
      n: "uploads"
      r: true
      sh: "A single-element array containing the upload object that is assocated with this campaign."
      t: "`$ARRAY`"
    }
    use_type: {
      h: "Use Type"
      n: "use_type"
      op: {
        update: {
          req: false
          type: "`$STRING`"
        }
      }
      r: true
      sh: "The use type for each mailpiece."
      t: "`$STRING`"
    }
  }

