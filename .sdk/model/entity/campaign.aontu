                t: "`$STRING`"
              }
            ]
          }
          m: "POST"
          o: "/campaigns/{cmp_id}/send"
          q: {
            "$action": "send"
            exist: [
              "id"
            ]
          }
          r: {
            param: {
              cmp_id: "id"
            }
          }
          s: [
            {
              lit: "campaigns"
            }
            {
              var: "id"
            }
            {
              lit: "send"
            }
