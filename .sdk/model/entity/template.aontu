      h: "Data"
      n: "data"
      r: false
      sh: "list of templates"
      t: "`$ARRAY`"
    }
    date_created: {
      fo: "date-time"
      h: "Date Created"
      n: "date_created"
      r: false
      sh: "A timestamp in ISO 8601 format of the date the resource was created."
      t: "`$STRING`"
    }
    date_modified: {
      fo: "date-time"
      h: "Date Modified"
      n: "date_modified"
