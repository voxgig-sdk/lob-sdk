      sh: "The engine used to combine HTML template with merge variables."
      t: "`$STRING`"
    }
    html: {
      h: "Html"
      n: "html"
      r: true
      sh: "An HTML string of less than 100,000 characters to be used as the `published_version` of this template."
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "Unique identifier prefixed with `tmpl_`."
      t: "`$STRING`"
    }
    metadata: {
      h: "Metadata"
      n: "metadata"
      r: false
      sh: "Use metadata to store custom information for tagging and labeling back to your internal systems."
      t: "`$OBJECT`"
    }
    next_url: {
      h: "Next Url"
      n: "next_url"
      r: false
      sh: "Url of next page of items in list."
      t: "`$STRING`"
    }
    object: {
      h: "Object"
      n: "object"
      r: false
      sh: "Value is resource type."
      t: "`$STRING`"
    }
    previous_url: {
      h: "Previous Url"
      n: "previous_url"
      r: false
      sh: "Url of previous page of items in list."
      t: "`$STRING`"
    }
    published_version: {
      h: "Published Version"
      n: "published_version"
      op: {
        create: {
          req: false
          type: "`$ANY`"
        }
      }
      r: true
      t: "`$ANY`"
    }
    required_vars: {
      h: "Required Vars"
      n: "required_vars"
      r: false
      sh: "An array of required variables to be used in a template."
      t: "`$ARRAY`"
    }
    total_count: {
      h: "Total Count"
      n: "total_count"
      r: false
      sh: "Indicates the total number of records."
      t: "`$INTEGER`"
    }
    versions: {
      h: "Versions"
      n: "versions"
      r: true
      sh: "An array of all non-deleted [version objects](#tag/Template-Versions) associated with the template."
      t: "`$ARRAY`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "template"
  op: {
    create: {
      name: "create"
      points: [
        {
          co: {
            id: "POST /templates/{tmpl_id}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "tmpl_id"
