                r: false
                t: "`$INTEGER`"
              }
              {
                k: "query"
                n: "metadata"
                or: "metadata"
                r: false
                t: "`$OBJECT`"
              }
            ]
          }
          m: "GET"
          o: "/templates"
          q: {
            exist: [
