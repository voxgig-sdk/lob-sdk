                t: "`$STRING`"
              }
            ]
          }
          m: "POST"
          o: "/templates/{tmpl_id}"
          q: {
            exist: [
              "id"
            ]
          }
          r: {
            param: {
              tmpl_id: "id"
            }
          }
          s: [
            {
              lit: "templates"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
