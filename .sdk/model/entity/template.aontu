          m: "DELETE"
          o: "/templates/{tmpl_id}"
          q: {
            exist: [
              "id"
            ]
          }
          r: {
            param: {
              tmpl_id: "id"
            }
          }
          s: [
            {
              lit: "templates"
            }
            {
              var: "id"
            }
          ]
          t: {
