# BasicAddressFlow

main: kit: flow: BasicAddressFlow:
{
  entity: "address",
  kind: "basic",
  name: "BasicAddressFlow",
  step: [
    {
      i: {
        ref: "address_ref01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "address_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "address_ref01",
        srcdatavar: "address_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "address01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-address_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "address_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "address01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "address_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicAddressFlow"
}