# BasicBuckslipFlow

main: kit: flow: BasicBuckslipFlow:
{
  entity: "buckslip",
  kind: "basic",
  name: "BasicBuckslipFlow",
  step: [
    {
      i: {
        ref: "buckslip_ref01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "buckslip_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "buckslip_ref01",
        srcdatavar: "buckslip_ref01_data",
        suffix: "_up0",
        textfield: "account_id"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-buckslip_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "buckslip_ref01",
        srcdatavar: "buckslip_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "buckslip01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-buckslip_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "buckslip_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "buckslip01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "buckslip_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicBuckslipFlow"
}