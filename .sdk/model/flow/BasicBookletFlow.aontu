# BasicBookletFlow

main: kit: flow: BasicBookletFlow:
{
  entity: "booklet",
  kind: "basic",
  name: "BasicBookletFlow",
  step: [
    {
      i: {
        ref: "booklet_ref01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "booklet_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "booklet_ref01",
        srcdatavar: "booklet_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "booklet01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-booklet_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "booklet_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "booklet01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "booklet_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicBookletFlow"
}