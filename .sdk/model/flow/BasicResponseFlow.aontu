# BasicResponseFlow

main: kit: flow: BasicResponseFlow:
{
  entity: "response",
  kind: "basic",
  name: "BasicResponseFlow",
  step: [
    {
      i: {
        ref: "response_ref01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "response_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "response_ref01",
        srcdatavar: "response_ref01_data",
        suffix: "_up0",
        textfield: "account_id"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-response_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "response_ref01",
        srcdatavar: "response_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "response01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-response_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicResponseFlow"
}