# BasicCampaignFlow

main: kit: flow: BasicCampaignFlow:
{
  entity: "campaign",
  kind: "basic",
  name: "BasicCampaignFlow",
  step: [
    {
      i: {
        ref: "campaign_ref01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "campaign_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "campaign_ref01",
        srcdatavar: "campaign_ref01_data",
        suffix: "_up0",
        textfield: "billing_group_id"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-campaign_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "campaign_ref01",
        srcdatavar: "campaign_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "campaign01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-campaign_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "campaign_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "campaign01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "campaign_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicCampaignFlow"
}