# BasicCreativeFlow

main: kit: flow: BasicCreativeFlow:
{
  entity: "creative",
  kind: "basic",
  name: "BasicCreativeFlow",
  step: [
    {
      i: {
        ref: "creative_ref01"
      }

      o: "create"
    }

    {
      i: {
        ref: "creative_ref01",
        srcdatavar: "creative_ref01_data",
        suffix: "_up0",
        textfield: "date_created"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-creative_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "creative_ref01",
        srcdatavar: "creative_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "creative01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-creative_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicCreativeFlow"
}